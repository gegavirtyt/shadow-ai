# Shadow AI Defensive Gateway - example configuration (see docs/DEPLOYMENT.md for all options).
# Never commit a real .env file.

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# Upstream (operator-controlled; clients cannot change it)
UPSTREAM_LLM_URL=https://api.openai.com/v1/chat/completions
UPSTREAM_PROVIDER=openai
UPSTREAM_API_KEY=
ALLOWED_UPSTREAM_HOSTS=api.openai.com
OPENAI_MODEL=gpt-4o-mini

# Workload authentication: required by default. Provide ONE of:
#   GATEWAY_WORKLOADS_FILE=/etc/shadow-ai-gateway/workloads.json   (SHA-256 digests, recommended)
#   GATEWAY_API_KEY=<random value, >= 24 chars>                    (single shared workload)
GATEWAY_AUTH_MODE=required
GATEWAY_API_KEY=
ALLOWED_MODELS=gpt-4o-mini

# Detection policy
PROMPT_INJECTION_MODE=block
ENTROPY_DETECTION=block

# Limits
MAX_REQUEST_BODY_SIZE=1048576
MAX_RESPONSE_BODY_SIZE=8388608
MAX_CONCURRENT_REQUESTS=64
RATE_LIMIT_PER_MINUTE=120
UPSTREAM_CONNECT_TIMEOUT=5
UPSTREAM_READ_TIMEOUT=60
STREAM_MAX_DURATION=300

# Audit fingerprint key (random, >= 32 bytes) so fingerprints correlate across replicas
AUDIT_HMAC_KEY=

# Development only - MUST be false in production
ALLOW_LOCAL_MOCK=false
ENABLE_TEST_ENDPOINTS=false
ENABLE_API_DOCS=false
